# ==============================================================================
# Rate Limit Validator & Stress Tester - Example Environment Variables
# ==============================================================================

# Default starting URL for validations
DEFAULT_TARGET_URL=https://httpbin.org/get

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default timeout in seconds for requests
DEFAULT_TIMEOUT_SECONDS=10

# SSL certificate verification mode (true/false)
VERIFY_SSL=true
