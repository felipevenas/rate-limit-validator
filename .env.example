# ==============================================================================
# Rate Limit Validator & Stress Tester - Variáveis de Ambiente de Exemplo
# ==============================================================================

# URL padrão inicial para validações
DEFAULT_TARGET_URL=https://httpbin.org/get

# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout padrão em segundos para requisições
DEFAULT_TIMEOUT_SECONDS=10

# Modo de verificação de certificados SSL (true/false)
VERIFY_SSL=true
